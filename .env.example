# ============================================================
# RECAST — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# --- ECMWF Open Data (AIFS-single, for predictions) ---
# API key from https://api.ecmwf.int/v1/key/
ECMWF_API_KEY=your-ecmwf-api-key-here

# --- CDS API (ERA5, for training data) ---
# Register at https://cds.climate.copernicus.eu/ and get your key
CDS_API_KEY=your-cds-api-key-here
CDS_API_URL=https://cds.climate.copernicus.eu/api

# --- Google Cloud Platform ---
# Path to your GCP service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=./credentials/gcp-service-account.json
# GCS bucket name for storing data, models, and predictions
GCS_BUCKET_NAME=recast-energy-forecast

# --- Prefect ---
# Leave empty for local execution; set for Prefect Cloud
# PREFECT_API_URL=https://api.prefect.cloud/api/accounts/...
# PREFECT_API_KEY=your-prefect-cloud-key

# --- Application ---
# "local" uses filesystem instead of GCS; "gcs" uses Google Cloud Storage
STORAGE_BACKEND=local
# Local data directory (used when STORAGE_BACKEND=local)
LOCAL_DATA_DIR=./data

# --- Logging ---
LOG_LEVEL=INFO
